{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "just-do-it",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "just_do_it",
			"database_name": "just-do-it",
			"database_id": "2ecea562-84a3-47ed-a37b-20a2e2d54ad3"
		}
	]
}